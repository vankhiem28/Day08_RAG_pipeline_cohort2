# OpenAI (Task 10 - Generation)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Jina AI (Task 7 - Reranking, optional)
JINA_API_KEY=jina_xxx

# PageIndex (Task 8 - Vectorless RAG)
PAGEINDEX_API_KEY=pi_xxx

# Weaviate Cloud (Task 4, optional - can use local Docker instead)
WEAVIATE_URL=https://xxx.weaviate.network
WEAVIATE_API_KEY=xxx

# Local RAG defaults
RAG_VECTOR_BACKEND=local
RAG_EMBEDDING_BACKEND=local
RAG_EMBEDDING_MODEL=local-hashing-v1
RAG_EMBEDDING_DIM=256
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_VECTOR_SCORE_THRESHOLD=0.18
RAG_HYBRID_SCORE_THRESHOLD=0.12

# To use a real local embedding model instead of local hashing:
# RAG_EMBEDDING_BACKEND=sentence-transformers
# RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# PostgreSQL + pgvector
# Set RAG_VECTOR_BACKEND=pgvector to use PostgreSQL as source of truth
# and pgvector as the vector search index.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rag_lab
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5432/rag_lab
